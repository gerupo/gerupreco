<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Spacing scale (8px base) from the "Neon Utility Dark" design system -->
    <dimen name="space_base">8dp</dimen>
    <dimen name="space_stack_gap">12dp</dimen>
    <dimen name="space_gutter">16dp</dimen>
    <dimen name="space_container_padding">20dp</dimen>
    <dimen name="space_margin_x">24dp</dimen>

    <!-- Borda lateral das telas de conteudo: enxuta porque os cards ja tem
         padding proprio, e a soma das duas e que define a moldura percebida -->
    <dimen name="space_screen_x">6dp</dimen>

    <!-- Corner radii -->
    <dimen name="radius_sm">4dp</dimen>
    <dimen name="radius_default">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>
    <dimen name="radius_xl">24dp</dimen>

    <!-- Components -->
    <dimen name="card_stroke">1dp</dimen>
    <dimen name="module_icon_size">80dp</dimen>
    <dimen name="module_icon_glyph">40dp</dimen>

    <!-- Marcas de canto do card: "no carrinho" a direita, "rastreado" a
         esquerda. O recuo e a folga que o cabecalho ganha de cada lado para o
         chip de tamanho e a descricao nao ficarem embaixo delas.

         Os dois valem para as duas marcas de proposito: sao a mesma forma em
         cantos opostos, e tamanhos diferentes fariam o card parecer torto. -->
    <dimen name="corner_mark_size">40dp</dimen>
    <dimen name="corner_mark_inset">12dp</dimen>


    <!-- Cards da tela inicial. Com tres modulos o card virou faixa horizontal:
         o glifo grande e empilhado nao cabia tres vezes na tela sem rolagem, e
         rolar para escolher modulo esconde uma das opcoes. -->
    <dimen name="module_icon_size_compact">56dp</dimen>
</resources>
