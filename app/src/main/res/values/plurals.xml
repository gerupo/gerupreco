<?xml version="1.0" encoding="utf-8"?>
<resources>

    <plurals name="cart_products">
        <item quantity="one">%1$d produto</item>
        <item quantity="other">%1$d produtos</item>
    </plurals>

    <plurals name="cart_units">
        <item quantity="one">%1$d unidade no total</item>
        <item quantity="other">%1$d unidades no total</item>
    </plurals>

    <plurals name="cart_added">
        <item quantity="one">%1$d produto adicionado ao carrinho</item>
        <item quantity="other">%1$d produtos adicionados ao carrinho</item>
    </plurals>

    <plurals name="cart_complete">
        <item quantity="one">Tem o produto do carrinho</item>
        <item quantity="other">Tem os %1$d produtos do carrinho</item>
    </plurals>

    <plurals name="cart_missing">
        <item quantity="one">Falta %1$d: %2$s</item>
        <item quantity="other">Faltam %1$d: %2$s</item>
    </plurals>

    <plurals name="cart_unavailable">
        <item quantity="one">%1$d produto sem preço em nenhum estabelecimento: %2$s</item>
        <item quantity="other">%1$d produtos sem preço em nenhum estabelecimento: %2$s</item>
    </plurals>

    <!-- Com um mercado filtrado, "nenhum estabelecimento" seria mentira: os
         outros podem ter o produto, só não estão sendo olhados. -->
    <plurals name="cart_unavailable_filtered">
        <item quantity="one">%1$d produto sem preço no mercado filtrado: %2$s</item>
        <item quantity="other">%1$d produtos sem preço no mercado filtrado: %2$s</item>
    </plurals>

    <plurals name="cart_unmeasured">
        <item quantity="one">%1$d produto sem tamanho válido no cadastro ficou de fora: %2$s. Edite o produto na lista e informe tamanho e unidade.</item>
        <item quantity="other">%1$d produtos sem tamanho válido no cadastro ficaram de fora: %2$s. Edite os produtos na lista e informe tamanho e unidade.</item>
    </plurals>

    <plurals name="price_window_days">
        <item quantity="one">%1$d dia</item>
        <item quantity="other">%1$d dias</item>
    </plurals>


    <plurals name="tracking_group_members">
        <item quantity="one">%d produto</item>
        <item quantity="other">%d produtos</item>
    </plurals>
</resources>
