<?xml version="1.0" encoding="utf-8"?>
<!-- Uma oferta do carrinho no ranking de custo-beneficio -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.GeruPreco.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_stack_gap"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_gutter">

        <!-- Linha fechada: posicao, produto, onde, e o preco por unidade -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/unit_price_rank"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_rank"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.GeruPreco.LabelCaps"
                android:textColor="@color/on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_stack_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/unit_price_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.GeruPreco.TitleMd" />

                <!-- Tamanho, preco da embalagem e data -->
                <TextView
                    android:id="@+id/unit_price_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.GeruPreco.BodySm" />

                <!--
                    Estabelecimento em linha propria, com o bairro: a mesma rede
                    tem filiais com nome identico, e duas delas praticando o
                    mesmo preco davam duas linhas indistinguiveis.
                -->
                <TextView
                    android:id="@+id/unit_price_market"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.GeruPreco.BodySm" />

            </LinearLayout>

            <!-- Preco por quilo ou litro: e por ele que a lista esta ordenada -->
            <TextView
                android:id="@+id/unit_price_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_base"
                android:text="@string/price_placeholder"
                android:textAppearance="@style/TextAppearance.GeruPreco.PriceDisplay" />

        </LinearLayout>

        <!-- Registro completo da oferta, aberto ao tocar no card -->
        <LinearLayout
            android:id="@+id/unit_price_breakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_stack_gap"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/unit_price_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_stack_gap"
            android:text="@string/cart_show_details"
            android:textAppearance="@style/TextAppearance.GeruPreco.LabelCaps"
            android:textColor="@color/secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
