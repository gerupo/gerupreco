<?xml version="1.0" encoding="utf-8"?>
<!-- O container raiz absorve os insets; o RecyclerView so cuida do proprio espacamento -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".activity.lowestprice.LowestPriceActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Janela de validade dos precos, a mesma das abas do carrinho -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_screen_x"
            android:layout_marginTop="@dimen/space_stack_gap"
            android:text="@string/price_window"
            android:textAppearance="@style/TextAppearance.GeruPreco.LabelCaps.Primary" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_screen_x"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/price_window_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_base"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />

        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_price_id"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_screen_x"
            android:paddingTop="@dimen/space_gutter"
            android:paddingBottom="@dimen/space_margin_x"
            android:scrollbars="none" />

    </LinearLayout>

    <!-- Nenhuma oferta dentro da janela escolhida -->
    <TextView
        android:id="@+id/lowest_price_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_margin_x"
        android:text="@string/lowest_price_empty"
        android:textAppearance="@style/TextAppearance.GeruPreco.BodySm"
        android:visibility="gone" />

</FrameLayout>
