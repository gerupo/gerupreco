<?xml version="1.0" encoding="utf-8"?>
<!-- Dois passos: primeiro o mercado, depois a loja. Nome sozinho nao
     identifica estabelecimento - ha tres "MUFFATAO" distintos. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_container_padding"
        android:paddingTop="@dimen/space_base"
        android:paddingBottom="@dimen/space_base">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cart_filter_market"
            android:textAppearance="@style/TextAppearance.GeruPreco.BodySm" />

        <Spinner
            android:id="@+id/filter_market"
            style="@style/Widget.GeruPreco.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_container_padding"
            android:text="@string/cart_filter_address"
            android:textAppearance="@style/TextAppearance.GeruPreco.BodySm" />

        <Spinner
            android:id="@+id/filter_address"
            style="@style/Widget.GeruPreco.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</ScrollView>
