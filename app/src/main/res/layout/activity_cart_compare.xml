<?xml version="1.0" encoding="utf-8"?>
<!-- O container raiz absorve os insets; as abas so cuidam do proprio espacamento.

     Tudo que vale para as duas leituras vive aqui: a janela de datas e o
     progresso da consulta. Cada aba recebe o mesmo carrinho e os mesmos precos
     e so muda o eixo do ranking. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".activity.cart.CartCompareActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/compare_tabs"
            style="@style/Widget.GeruPreco.Tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Completa o nome da aba: sozinhos, "Mercados" e "Produtos" dizem o
             que e ranqueado, mas nao a pergunta que a aba responde -->
        <TextView
            android:id="@+id/compare_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_screen_x"
            android:layout_marginTop="@dimen/space_stack_gap"
            android:textAppearance="@style/TextAppearance.GeruPreco.BodySm" />

        <!-- Janela de validade dos precos, valida para as duas abas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_screen_x"
            android:layout_marginTop="@dimen/space_stack_gap"
            android:text="@string/cart_price_window"
            android:textAppearance="@style/TextAppearance.GeruPreco.LabelCaps.Primary" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_screen_x"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/compare_window_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_base"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />

        </HorizontalScrollView>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/compare_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_stack_gap"
            android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>
