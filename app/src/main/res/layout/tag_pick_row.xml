<?xml version="1.0" encoding="utf-8"?>
<!-- Uma tag na escolha de adicionar por tag -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_base">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/tag_pick_chip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tag_pick_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_base"
        android:textAppearance="@style/TextAppearance.GeruPreco.LabelCaps" />

</LinearLayout>
