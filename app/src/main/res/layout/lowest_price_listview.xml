<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.GeruPreco.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_stack_gap"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_gutter">

        <!-- Establishment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_tile"
                android:contentDescription="@string/establishment"
                android:padding="10dp"
                android:src="@drawable/ic_store_24"
                app:tint="@color/secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_stack_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lp_company"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/establishment"
                    android:textAppearance="@style/TextAppearance.GeruPreco.TitleMd" />

                <TextView
                    android:id="@+id/lp_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/address"
                    android:textAppearance="@style/TextAppearance.GeruPreco.BodySm" />

            </LinearLayout>

        </LinearLayout>

        <!-- Product description -->
        <TextView
            android:id="@+id/lp_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_stack_gap"
            android:text="@string/product"
            android:textAppearance="@style/TextAppearance.GeruPreco.BodySm"
            android:textColor="@color/on_surface" />

        <!-- Freshness metadata -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/last_update"
                android:src="@drawable/ic_history_24"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/lp_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GeruPreco.LabelCaps" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_base"
                android:text="@string/bullet"
                android:textAppearance="@style/TextAppearance.GeruPreco.LabelCaps" />

            <TextView
                android:id="@+id/lp_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.GeruPreco.LabelCaps" />

        </LinearLayout>

        <!-- Price -->
        <TextView
            android:id="@+id/lp_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_stack_gap"
            android:text="@string/price_placeholder"
            android:textAppearance="@style/TextAppearance.GeruPreco.PriceDisplay.Large" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
