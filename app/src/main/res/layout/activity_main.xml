<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingHorizontal="@dimen/space_margin_x"
        android:paddingVertical="@dimen/space_margin_x"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="@string/module_subtitle"
                android:textAppearance="@style/TextAppearance.GeruPreco.BodyMd"
                android:textColor="@color/on_surface_variant" />

            <!-- GeruPreço -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gerupreco"
                style="@style/Widget.GeruPreco.Card.Module"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_stack_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ImageView
                        android:layout_width="@dimen/module_icon_size"
                        android:layout_height="@dimen/module_icon_size"
                        android:layout_marginBottom="@dimen/space_margin_x"
                        android:background="@drawable/bg_module_icon"
                        android:contentDescription="@string/module_gerupreco"
                        android:elevation="10dp"
                        android:outlineAmbientShadowColor="@color/primary_container"
                        android:outlineProvider="background"
                        android:outlineSpotShadowColor="@color/primary_container"
                        android:padding="20dp"
                        android:src="@drawable/ic_payments_24"
                        app:tint="@color/on_primary_container" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_base"
                        android:gravity="center"
                        android:text="@string/module_gerupreco"
                        android:textAppearance="@style/TextAppearance.GeruPreco.HeadlineLg" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/module_gerupreco_description"
                        android:textAppearance="@style/TextAppearance.GeruPreco.BodyMd"
                        android:textColor="@color/on_surface_variant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- GeruRegra -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gerometro"
                style="@style/Widget.GeruPreco.Card.Module"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ImageView
                        android:layout_width="@dimen/module_icon_size"
                        android:layout_height="@dimen/module_icon_size"
                        android:layout_marginBottom="@dimen/space_margin_x"
                        android:background="@drawable/bg_module_icon"
                        android:contentDescription="@string/module_geruregra"
                        android:elevation="10dp"
                        android:outlineAmbientShadowColor="@color/primary_container"
                        android:outlineProvider="background"
                        android:outlineSpotShadowColor="@color/primary_container"
                        android:padding="20dp"
                        android:src="@drawable/ic_calculate_24"
                        app:tint="@color/on_primary_container" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_base"
                        android:gravity="center"
                        android:text="@string/module_geruregra"
                        android:textAppearance="@style/TextAppearance.GeruPreco.HeadlineLg" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/module_geruregra_description"
                        android:textAppearance="@style/TextAppearance.GeruPreco.BodyMd"
                        android:textColor="@color/on_surface_variant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
