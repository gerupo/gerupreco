<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingHorizontal="@dimen/space_margin_x"
        android:paddingVertical="@dimen/space_margin_x"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_margin_x"
                android:gravity="center"
                android:text="@string/module_subtitle"
                android:textAppearance="@style/TextAppearance.GeruPreco.BodyMd"
                android:textColor="@color/on_surface_variant" />

            <!--
                Com o terceiro modulo o card deixou de ser o bloco alto com o
                glifo empilhado: tres deles nao cabiam na tela, e a escolha de
                modulo e a unica coisa que esta tela faz - rolar para ver uma
                das opcoes seria esconder justamente o que ela oferece.
            -->

            <!-- GeruPreço -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gerupreco"
                style="@style/Widget.GeruPreco.Card.Module"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_stack_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_container_padding">

                    <ImageView
                        android:layout_width="@dimen/module_icon_size_compact"
                        android:layout_height="@dimen/module_icon_size_compact"
                        android:background="@drawable/bg_module_icon"
                        android:contentDescription="@string/module_gerupreco"
                        android:elevation="10dp"
                        android:outlineAmbientShadowColor="@color/primary_container"
                        android:outlineProvider="background"
                        android:outlineSpotShadowColor="@color/primary_container"
                        android:padding="14dp"
                        android:src="@drawable/ic_payments_24"
                        app:tint="@color/on_primary_container" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_gutter"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/module_gerupreco"
                            android:textAppearance="@style/TextAppearance.GeruPreco.TitleMd" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/module_gerupreco_description"
                            android:textAppearance="@style/TextAppearance.GeruPreco.BodySm" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/space_base"
                        android:contentDescription="@string/module_gerupreco"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Rastreamento de preços -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tracking"
                style="@style/Widget.GeruPreco.Card.Module"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_stack_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_container_padding">

                    <ImageView
                        android:layout_width="@dimen/module_icon_size_compact"
                        android:layout_height="@dimen/module_icon_size_compact"
                        android:background="@drawable/bg_module_icon"
                        android:contentDescription="@string/module_tracking"
                        android:elevation="10dp"
                        android:outlineAmbientShadowColor="@color/primary_container"
                        android:outlineProvider="background"
                        android:outlineSpotShadowColor="@color/primary_container"
                        android:padding="14dp"
                        android:src="@drawable/ic_trending_down_24"
                        app:tint="@color/on_primary_container" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_gutter"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/module_tracking"
                            android:textAppearance="@style/TextAppearance.GeruPreco.TitleMd" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/module_tracking_description"
                            android:textAppearance="@style/TextAppearance.GeruPreco.BodySm" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/space_base"
                        android:contentDescription="@string/module_tracking"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- GeruRegra -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gerometro"
                style="@style/Widget.GeruPreco.Card.Module"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_container_padding">

                    <ImageView
                        android:layout_width="@dimen/module_icon_size_compact"
                        android:layout_height="@dimen/module_icon_size_compact"
                        android:background="@drawable/bg_module_icon"
                        android:contentDescription="@string/module_geruregra"
                        android:elevation="10dp"
                        android:outlineAmbientShadowColor="@color/primary_container"
                        android:outlineProvider="background"
                        android:outlineSpotShadowColor="@color/primary_container"
                        android:padding="14dp"
                        android:src="@drawable/ic_calculate_24"
                        app:tint="@color/on_primary_container" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_gutter"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/module_geruregra"
                            android:textAppearance="@style/TextAppearance.GeruPreco.TitleMd" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/module_geruregra_description"
                            android:textAppearance="@style/TextAppearance.GeruPreco.BodySm" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/space_base"
                        android:contentDescription="@string/module_geruregra"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
