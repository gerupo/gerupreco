<?xml version="1.0" encoding="utf-8"?>
<!-- Aba "Produtos": ranking de custo-beneficio por quilo e por litro.
     Quem absorve os insets e a raiz da CartCompareActivity - aqui a raiz e um
     FrameLayout que nao rola, so o RecyclerView dentro dele. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.cart.UnitPriceFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Produtos sem tamanho valido no cadastro: fora da comparacao.
             Separado do aviso abaixo porque a acao e outra - um se resolve no
             cadastro, o outro abrindo a janela de datas. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/unit_price_unmeasured_card"
            style="@style/Widget.GeruPreco.Card.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_screen_x"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/space_stack_gap">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="@dimen/space_base"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@string/cart_unit_price_fix"
                    android:src="@drawable/ic_error_outline_24"
                    app:tint="@color/error" />

                <TextView
                    android:id="@+id/unit_price_unmeasured_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.GeruPreco.BodySm" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Produtos sem preco em nenhum estabelecimento da janela -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/unit_price_unpriced_card"
            style="@style/Widget.GeruPreco.Card.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_screen_x"
            android:layout_marginTop="@dimen/space_stack_gap"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/space_stack_gap">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="@dimen/space_base"
                    android:layout_marginTop="2dp"
                    android:contentDescription="@string/cart_coverage"
                    android:src="@drawable/ic_error_outline_24"
                    app:tint="@color/error" />

                <TextView
                    android:id="@+id/unit_price_unpriced_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.GeruPreco.BodySm" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/unit_price_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_screen_x"
            android:paddingTop="@dimen/space_stack_gap"
            android:paddingBottom="@dimen/space_margin_x"
            android:scrollbars="none" />

    </LinearLayout>

    <!-- Nenhum produto com preco e tamanho para comparar -->
    <TextView
        android:id="@+id/unit_price_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_margin_x"
        android:text="@string/cart_unit_price_empty"
        android:textAppearance="@style/TextAppearance.GeruPreco.BodySm"
        android:visibility="gone" />

</FrameLayout>
