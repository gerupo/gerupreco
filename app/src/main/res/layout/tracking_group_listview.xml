<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tracking_group_card"
    style="@style/Widget.GeruPreco.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_stack_gap"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="@dimen/space_base"
                android:contentDescription="@string/tracking_groups_header"
                android:src="@drawable/ic_label_24"
                app:tint="@color/secondary" />

            <TextView
                android:id="@+id/tracking_group_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tracking_group_name"
                android:textAppearance="@style/TextAppearance.GeruPreco.TitleMd" />

            <TextView
                android:id="@+id/tracking_group_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_stack_gap"
                android:text="@string/price_placeholder"
                android:textAppearance="@style/TextAppearance.GeruPreco.PriceDisplay" />

            <!-- Aponta para a direita fechado e para baixo aberto: o toque no
                 card abre o grupo, como uma pasta, e editar fica no long press. -->
            <ImageView
                android:id="@+id/tracking_group_chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/space_base"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right_24"
                app:tint="@color/on_surface_variant" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tracking_group_scope"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tracking_scope_all"
                android:textAppearance="@style/TextAppearance.GeruPreco.LabelCaps" />

            <TextView
                android:id="@+id/tracking_group_members"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_base"
                android:textAppearance="@style/TextAppearance.GeruPreco.LabelCaps.Primary" />

            <TextView
                android:id="@+id/tracking_group_paused"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_base"
                android:background="@drawable/bg_chip"
                android:text="@string/tracking_paused"
                android:textAppearance="@style/TextAppearance.GeruPreco.LabelCaps"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
