<?xml version="1.0" encoding="utf-8"?>
<!--
    Marca de "ja esta no carrinho", sobreposta ao canto superior direito do card.

    O triangulo cobre o canto e acompanha o raio do card (radius_lg = 16), de
    modo que a borda arredondada da marca coincida com a do MaterialCardView.
    O carrinho vem do ic_shopping_cart_24, encolhido e deslocado para dentro do
    triangulo por um <group>: fora dele o glifo cairia sobre o fundo escuro do
    card e sumiria.

    As cores repetem o fundo do arrasto para a direita (primary_container +
    on_primary): a marca e o resultado visivel daquele gesto.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="40"
    android:viewportHeight="40">

    <path
        android:fillColor="@color/primary_container"
        android:pathData="M0,0 L24,0 A16,16 0 0 1 40,16 L40,40 Z" />

    <group
        android:scaleX="0.55"
        android:scaleY="0.55"
        android:translateX="21"
        android:translateY="6">
        <path
            android:fillColor="@color/on_primary"
            android:pathData="M7,18c-1.1,0 -1.99,0.9 -1.99,2S5.9,22 7,22c1.1,0 2,-0.9 2,-2s-0.9,-2 -2,-2zM1,2v2h2l3.6,7.59 -1.35,2.45c-0.16,0.28 -0.25,0.61 -0.25,0.96 0,1.1 0.9,2 2,2h12v-2H7.42c-0.14,0 -0.25,-0.11 -0.25,-0.25l0.03,-0.12 0.9,-1.63h7.45c0.75,0 1.41,-0.41 1.75,-1.03l3.58,-6.49c0.08,-0.14 0.12,-0.31 0.12,-0.48 0,-0.55 -0.45,-1 -1,-1H5.21l-0.94,-2H1zM17,18c-1.1,0 -1.99,0.9 -1.99,2s0.89,2 1.99,2c1.1,0 2,-0.9 2,-2s-0.9,-2 -2,-2z" />
    </group>

</vector>
